---
/**
 * Home page: an optional portrait next to a short bio.
 *
 * To add a portrait, save a square-ish photo as src/assets/portrait.jpg
 * (png, webp and avif also work). With no portrait file, the page shows
 * the text on its own.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

// Looks for a portrait file. The result is empty if you have not added one.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/portrait.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const portrait = Object.values(portraits)[0]?.default;

// Only links that have an address are shown.
const links = site.links.filter((link) => link.href);
---

<Base>
	<main class="home">
		<div class="intro">
			{
				portrait && (
					<Image
						class="portrait"
						src={portrait}
						alt={`Portrait of ${site.name}`}
						width={440}
						height={440}
						fit="cover"
						loading="eager"
					/>
				)
			}

			<div class="bio">
				<h1>{site.name}</h1>

				<!--
					Your bio. Wrap a word in <strong> to make it brighter,
					or in <a href="..."> to make it a link.

					Keep each tag on the same line as the word before it. Astro removes
					a line break that sits directly next to a tag, which would join two
					words together. Breaking a line between plain words is fine.
				-->
				<p>
					I'm an MBA student at <strong>IIM Nagpur</strong> with a background
					in <strong>computer science</strong>.
				</p>
				<p>
					Previously, I built dashboards and internal tools in Python
					at <strong>BrainyBeam InfoTech</strong>.
				</p>
				<p>
					This site is where I keep my <a href="/writing/">writing</a>, <a href="/photography/">photography</a> and <a href="/music/">music</a>.
				</p>

				{
					links.length > 0 && (
						<ul class="links">
							{links.map((link) => (
								<li>
									<a href={link.href} rel="me noopener" target="_blank">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</main>
</Base>

<style>
	/* Centres the intro in the middle of the screen. */
	.home {
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 4rem 1.5rem 6rem;
	}

	.intro {
		display: flex;
		align-items: flex-start;
		gap: 3.5rem;
		max-width: 52rem;
	}

	.portrait {
		flex-shrink: 0;
		width: 13rem;
		height: 13rem;
		border-radius: var(--radius);
		object-fit: cover;
	}

	.bio {
		max-width: 31rem;
	}

	.bio h1 {
		margin-bottom: 1.25rem;
	}

	.bio p + p {
		margin-top: 1rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}

	/* On narrow screens the portrait sits above the text. */
	@media (max-width: 44rem) {
		.intro {
			flex-direction: column;
			gap: 2rem;
		}

		.portrait {
			width: 9rem;
			height: 9rem;
		}
	}
</style>
