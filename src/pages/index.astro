---
/**
 * Home page: an optional portrait next to a short bio.
 *
 * To add a portrait, save a square-ish photo as src/assets/portrait.jpg
 * (png, webp and avif also work). With no portrait file, the page shows
 * the text on its own.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

// Looks for a portrait file. The result is empty if you have not added one.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/portrait.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const portrait = Object.values(portraits)[0]?.default;
---

<Base>
	<main class="home">
		<div class="intro">
			{
				portrait && (
					<Image
						class="portrait"
						src={portrait}
						alt={`Portrait of ${site.name}`}
						width={440}
						height={440}
						fit="cover"
						loading="eager"
					/>
				)
			}

			<div class="bio">
				{/*
					The heading is the greeting itself, so the page opens with it in
					large type and the paragraphs below do not have to repeat it.
					Your full name is still the title of the browser tab and of the
					page in search results (it comes from src/site.ts).
				*/}
				<h1>Hi, I’m Rudra.</h1>

				{/*
					Your bio: one <p>...</p> per paragraph. Wrap a word in <strong> to
					make it brighter, or in <a href="..."> to make it a link.

					Keep each tag on the same line as the word before it. Astro removes
					a line break that sits directly next to a tag, which would join two
					words together. Breaking a line between plain words is fine.
				*/}
				<p>
					I was born in <strong>India</strong> and have lived in
					the <strong>United Kingdom</strong>.
				</p>
				<p>
					Engineer by training, now <strong>debugging businesses</strong>. Currently
					an MBA student at <strong>IIM Nagpur</strong>, applying a systems mindset
					to strategy and operations. I build things that make work more human.
				</p>

				{/*
					The closing line, set a little apart from the bio. Its three links
					get their addresses from src/site.ts, under `contact`.
					  hello:  "mailto:" makes the visitor's mail app open a new message.
					  code and tweets: target="_blank" opens the page in a new tab, and
					  rel="me" tells search engines those profiles belong to you.
					The sentence is kept on one line so no spaces are lost (see the note above).
				*/}
				<p class="contact">
					Say <a href={`mailto:${site.contact.email}`}>hello</a>, fork my <a href={site.contact.github} rel="me noopener" target="_blank">code</a>, or share my <a href={site.contact.twitter} rel="me noopener" target="_blank">tweets</a>.
				</p>
			</div>
		</div>
	</main>
</Base>

<style>
	/* Centres the intro in the middle of the screen. */
	.home {
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 4rem 1.5rem 6rem;
	}

	.intro {
		display: flex;
		align-items: flex-start;
		gap: 3.5rem;
		max-width: 52rem;
	}

	.portrait {
		flex-shrink: 0;
		width: 13rem;
		height: 13rem;
		border-radius: var(--radius);
		object-fit: cover;
	}

	.bio {
		max-width: 31rem;
	}

	.bio h1 {
		margin-bottom: 1.25rem;
	}

	/*
	 * Justified text: the browser widens the spaces between words so that
	 * every full line reaches both edges of the column, giving the bio straight
	 * left and right sides. The last line of a paragraph is not stretched.
	 */
	.bio p {
		text-align: justify;
	}

	.bio p + p {
		margin-top: 1rem;
	}

	/* The closing line sits a little further down, like a sign-off. */
	.bio .contact {
		margin-top: 1.5rem;
	}

	/*
	 * Links are bright like the emphasised words, plus a faint underline so
	 * they can be told apart from them. color-mix() makes the line a
	 * see-through version of the text colour (currentColor), so it suits
	 * both light and dark mode. On hover the line becomes fully solid.
	 */
	.bio a {
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
		transition: text-decoration-color 0.2s ease;
	}

	.bio a:hover {
		text-decoration-color: currentColor;
	}

	/* On narrow screens the portrait sits above the text. */
	@media (max-width: 44rem) {
		.intro {
			flex-direction: column;
			gap: 2rem;
		}

		.portrait {
			width: 9rem;
			height: 9rem;
		}
	}

	/*
	 * On phones a line holds only a few words, so stretching it can leave wide
	 * gaps. Letting the browser split a long word with a hyphen at the end of a
	 * line keeps the gaps small. It uses the page's language (lang="en" in
	 * Base.astro) to know where a word may be split. The -webkit- line is the
	 * same setting under the name older versions of Safari use.
	 */
	@media (max-width: 32rem) {
		.bio p {
			-webkit-hyphens: auto;
			hyphens: auto;
		}
	}
</style>
