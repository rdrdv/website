---
/**
 * Home page: an optional portrait next to a short bio.
 *
 * To add a portrait, save a square-ish photo as src/assets/portrait.jpg
 * (png, webp and avif also work). With no portrait file, the page shows
 * the text on its own.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { site } from '../site';

// Looks for a portrait file. The result is empty if you have not added one.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/portrait.{jpg,jpeg,png,webp,avif}',
	{ eager: true },
);
const portrait = Object.values(portraits)[0]?.default;
---

<Base>
	<main class="home">
		<div class="intro">
			{
				portrait && (
					<Image
						class="portrait"
						src={portrait}
						alt={`Portrait of ${site.name}`}
						width={440}
						height={440}
						fit="cover"
						loading="eager"
					/>
				)
			}

			<div class="bio">
					{/*
						The page's heading. It is not shown on screen, because the first
						line below already introduces you, but search engines and screen
						readers still use it as the title of the page.
					*/}
					<h1 class="hidden-heading">{site.name}</h1>

					{/*
						Your bio: one <p>...</p> per paragraph. Wrap a word in <strong> to
						make it brighter, or in <a href="..."> to make it a link.

						Keep each tag on the same line as the word before it. Astro removes
						a line break that sits directly next to a tag, which would join two
						words together. Breaking a line between plain words is fine.
					*/}
					<p>
						Hi, I’m Rudra. I was born in India and have lived in the United
						Kingdom.
					</p>
					<p>
						Engineer by training, now debugging businesses. Currently an MBA
						student at IIM Nagpur, applying a systems mindset to strategy and
						operations. I build things that make work more human.
					</p>

					{/*
						The three links. Their addresses are set in src/site.ts, under `contact`.
						  hello:  "mailto:" makes the visitor's mail app open a new message.
						  code and tweets: target="_blank" opens the page in a new tab, and
						  rel="me" tells search engines those profiles belong to you.
						The sentence is kept on one line so no spaces are lost (see the note above).
					*/}
					<p>
						Say <a href={`mailto:${site.contact.email}`}>hello</a>, fork my <a href={site.contact.github} rel="me noopener" target="_blank">code</a>, or share my <a href={site.contact.twitter} rel="me noopener" target="_blank">tweets</a>.
					</p>
				</div>
		</div>
	</main>
</Base>

<style>
	/* Centres the intro in the middle of the screen. */
	.home {
		display: grid;
		place-items: center;
		min-height: 100dvh;
		padding: 4rem 1.5rem 6rem;
	}

	.intro {
		display: flex;
		align-items: flex-start;
		gap: 3.5rem;
		max-width: 52rem;
	}

	.portrait {
		flex-shrink: 0;
		width: 13rem;
		height: 13rem;
		border-radius: var(--radius);
		object-fit: cover;
	}

	.bio {
		max-width: 31rem;
	}

	/*
	 * Hides the heading from view while leaving it readable by search engines
	 * and screen readers: it is shrunk to a single clipped pixel instead of
	 * being removed with display: none, which would hide it from them too.
	 */
	.hidden-heading {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.bio p + p {
		margin-top: 1rem;
	}

	/* Links inside a sentence are always underlined, so they stand out from the words around them. */
	.bio a {
		text-decoration: underline;
	}

	/* On narrow screens the portrait sits above the text. */
	@media (max-width: 44rem) {
		.intro {
			flex-direction: column;
			gap: 2rem;
		}

		.portrait {
			width: 9rem;
			height: 9rem;
		}
	}
</style>
