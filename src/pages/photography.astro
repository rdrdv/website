---
/**
 * Photography: a grid of every image in src/assets/photos.
 *
 * To add a photo, drop the file into that folder. Nothing else to edit.
 *   - Order: by file name, last name first. Starting names with the date,
 *     e.g. 2026-11-10-marine-drive.jpg, puts the newest photo at the top.
 *   - Description: taken from the file name. The example above is described
 *     to screen readers as "marine drive".
 *
 * Astro resizes and compresses each image at build time, so visitors
 * download a small version for the grid and a larger one only when they
 * open a photo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { sections } from '../site';

// If this section is switched off in src/site.ts, answer "not found" instead of building the page.
if (!sections.photography.enabled) return new Response(null, { status: 404 });

// Loads every image in the folder. Camera exports often use upper-case extensions.
const files = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/photos/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
	{ eager: true },
);

/** Turns ".../2026-11-10-marine-drive.jpg" into "marine drive". */
function altFromPath(path: string) {
	const name = path.split('/').pop() ?? '';
	const text = name
		.replace(/\.[^.]+$/, '') // remove the extension
		.replace(/^\d{4}-\d{2}-\d{2}[-_ ]?/, '') // remove a leading date
		.replace(/[-_]+/g, ' ')
		.trim();
	return text || 'Photograph';
}

const photos = Object.entries(files)
	.sort(([a], [b]) => b.localeCompare(a))
	.map(([path, file], index) => ({
		id: `photo-${index}`,
		src: file.default,
		alt: altFromPath(path),
	}));
---

<Base title="Photography" description="Photographs.">
	<main>
		{/*
			The title sits in the same narrow column as on Writing and Music, so it
			does not move when switching pages. The photo grid below is wider.
		*/}
		<div class="page has-wide">
			<header class="page-header">
				<h1>Photography</h1>
			</header>

			{photos.length === 0 && <p class="empty">No photographs yet.</p>}
		</div>

		{
			photos.length > 0 && (
				<div class="wide">
					<div class="grid">
						{/* The thumbnails. Clicking one opens the full-screen view with the same id. */}
						{photos.map((photo) => (
							<button
								class="thumb"
								type="button"
								popovertarget={photo.id}
								aria-label={`View larger: ${photo.alt}`}
							>
								<Image
									src={photo.src}
									alt={photo.alt}
									widths={[480, 800, 1200]}
									sizes="(min-width: 60rem) 33vw, (min-width: 36rem) 50vw, 100vw"
								/>
							</button>
						))}
					</div>
				</div>
			)
		}

		{
			/*
			 * The full-screen views, one per photo, kept outside the grid so the
			 * column layout cannot affect them. The large image is lazy, so the
			 * browser downloads it only when the photo is opened. Each view is one
			 * big button: clicking anywhere, or pressing Escape, closes it.
			 */
			photos.map((photo) => (
				<div class="lightbox" id={photo.id} popover>
					<button
						type="button"
						popovertarget={photo.id}
						popovertargetaction="hide"
						aria-label="Close"
					>
						<Image
							src={photo.src}
							alt={photo.alt}
							width={Math.min(photo.src.width, 2400)}
							loading="lazy"
						/>
					</button>
				</div>
			))
		}
	</main>
</Base>

<style>
	/*
	 * CSS columns give a "masonry" layout: photos keep their own proportions
	 * and stack in columns, so portrait and landscape shots mix cleanly.
	 * The browser fits as many 17rem-wide columns as the screen allows, up to 3.
	 */
	.grid {
		columns: 3 17rem;
		column-gap: 1rem;
	}

	.thumb {
		display: block;
		width: 100%;
		margin: 0 0 1rem;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		overflow: hidden;
		background: var(--surface);
		cursor: zoom-in;
		break-inside: avoid;
	}

	/* :global() is needed because the img element is produced by <Image>, not by this file. */
	.thumb :global(img) {
		width: 100%;
		transition: opacity 0.2s ease;
	}

	.thumb:hover :global(img) {
		opacity: 0.85;
	}

	/*
	 * The full-screen view. It stays dark in light mode too, because photos
	 * read best against a dark surround. `display` is left alone so a closed
	 * popover stays hidden.
	 */
	.lightbox {
		inset: 0;
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: rgb(10 10 10 / 0.96);
	}

	.lightbox button {
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-out;
	}

	/* Fits the photo inside the screen, with a margin, whatever its proportions. */
	.lightbox :global(img) {
		width: auto;
		height: auto;
		max-width: calc(100vw - 2rem);
		max-height: calc(100dvh - 2rem);
		object-fit: contain;
	}
</style>
