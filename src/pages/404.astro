---
/** Shown when someone opens an address that does not exist. */
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="This page does not exist.">
	<main class="page">
		<header class="page-header">
			<h1>Page not found</h1>
			<p>There is nothing at this address. <a href="/">Go home</a>.</p>
		</header>
	</main>
</Base>
