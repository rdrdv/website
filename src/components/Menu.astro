---
/**
 * The floating "Menu" button and the panel it opens.
 *
 * It uses the browser's built-in Popover API, so it needs no JavaScript:
 *   - `popovertarget="site-menu"` on a button opens/closes the element with that id
 *   - the browser closes it when you press Escape or click outside it
 */
import { nav } from '../site';

// The address of the page being built, used to highlight the current section.
const current = Astro.url.pathname;

/** True when `href` is the page being viewed (or, for sections, a page inside it). */
function isActive(href: string) {
	if (href === '/') return current === '/';
	return current.startsWith(href.replace(/\/$/, ''));
}
---

<button class="menu-button" type="button" popovertarget="site-menu">Menu</button>

<nav id="site-menu" popover aria-label="Site">
	{
		nav.map((group) => (
			<>
				{group.map((item) => (
					<a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))}
				<hr />
			</>
		))
	}
	<button type="button" popovertarget="site-menu" popovertargetaction="hide">Close</button>
</nav>

<style>
	.menu-button {
		position: fixed;
		left: var(--edge);
		bottom: var(--edge);
		z-index: 10;
		padding: 0.5rem 1rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 0.9rem;
		cursor: pointer;
		transition: background-color 0.15s ease;
	}

	.menu-button:hover {
		background: var(--surface-hover);
	}

	/*
	 * A popover is centred on screen by default. These rules pin it to the
	 * bottom-left corner, on top of the Menu button.
	 * Note: `display` is deliberately not set here, because the browser uses it
	 * to keep a closed popover hidden.
	 */
	#site-menu {
		inset: auto auto var(--edge) var(--edge);
		margin: 0;
		min-width: 12rem;
		padding: 1rem 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		color: var(--muted);
		box-shadow: var(--shadow);
		font-size: 1.05rem;

		/* Closed state, which the panel animates from and back to. */
		opacity: 0;
		transform: translateY(6px) scale(0.98);
		transform-origin: bottom left;
		transition:
			opacity 0.16s ease,
			transform 0.16s ease,
			overlay 0.16s allow-discrete,
			display 0.16s allow-discrete;
	}

	#site-menu:popover-open {
		opacity: 1;
		transform: none;
	}

	/* The values to animate from on the first frame after the panel opens. */
	@starting-style {
		#site-menu:popover-open {
			opacity: 0;
			transform: translateY(6px) scale(0.98);
		}
	}

	#site-menu a,
	#site-menu button {
		display: block;
		width: 100%;
		padding: 0.3rem 0;
		border: 0;
		background: none;
		color: var(--muted);
		font: inherit;
		text-align: left;
		text-decoration: none;
		cursor: pointer;
		transition: color 0.15s ease;
	}

	#site-menu a:hover,
	#site-menu button:hover,
	#site-menu a[aria-current='page'] {
		color: var(--text);
	}

	#site-menu hr {
		margin: 0.6rem 0;
		border: 0;
		border-top: 1px solid var(--border);
	}
</style>
