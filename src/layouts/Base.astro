---
/**
 * The shell shared by every page: the <head> tags, the global styles,
 * the fonts and the scroll navigation. A page wraps its content in <Base>
 * and that content appears where <slot /> is.
 */
import '@fontsource-variable/inter'; // Self-hosted Inter, so no request goes to Google Fonts.
import '../styles/global.css';
import ScrollNav from '../components/ScrollNav.astro';
import { pageOrder, sections, site } from '../site';

interface Props {
	/** Page title. Left out on the home page, which shows only the site name. */
	title?: string;
	/** Description for search results and link previews. Defaults to the site description. */
	description?: string;
}

const { title, description = site.description } = Astro.props;

// "Writing · Rudra Dave" on inner pages, "Rudra Dave" on the home page.
const fullTitle = title ? `${title} · ${site.name}` : site.name;

// The absolute address of this page, e.g. https://rdrdv.com/writing/
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * Where this page sits in the order visitors scroll through.
 * `here` is its position in pageOrder (0 = Home), or -1 if it is not one of
 * those pages. `parent` is the section a deeper page belongs to: for a blog
 * post, that is Writing.
 */
const path = Astro.url.pathname.replace(/\/?$/, '/'); // always ends in a slash
const here = pageOrder.findIndex((page) => page.href === path);
const parent =
	here === -1 ? pageOrder.findIndex((page) => page.href !== '/' && path.startsWith(page.href)) : -1;

// The pages above and below. A blog post has only "above": the list of posts.
const previous = here > 0 ? pageOrder[here - 1] : parent !== -1 ? pageOrder[parent] : undefined;
const next = here !== -1 ? pageOrder[here + 1] : undefined;

/*
 * A number that grows down the stack: Home 0, Writing 1, a post 1.5, Music 2.
 * The script in <head> compares it with the previous page's number to tell
 * which way to slide. Pages outside the stack ("Page not found") have none.
 */
const order = here !== -1 ? here : parent !== -1 ? parent + 0.5 : undefined;
---

<!doctype html>
<html lang="en" data-order={order}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- Colours the browser's own toolbar to match the page, in each mode. -->
		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />

		<!-- Used by messaging apps and social networks when the link is shared. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />

		<!-- Lets feed readers discover the blog's RSS feed (only while Writing is switched on). -->
		{
			sections.writing.enabled && (
				<link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
			)
		}
			<link rel="sitemap" href="/sitemap-index.xml" />

			{/*
				Chooses the direction of the slide between two pages.

				The browser fires "pagereveal" just before it first draws a page. If it
				is about to animate from the previous page, the event carries that
				animation as `viewTransition`. This compares the two pages' positions in
				the stack and labels the animation "forward" (the new page is lower) or
				"back" (it is higher); global.css holds the slide for each label.

				The previous page's position is kept in sessionStorage, a small store
				that lasts as long as the browser tab. Because it is updated on every
				page, the Back and Forward buttons slide the right way too.

				`is:inline` keeps the script here, exactly as written. Astro would
				otherwise load it later, after the first draw, which is too late.
			*/}
			<script is:inline>
				window.addEventListener('pagereveal', (event) => {
					const here = Number(document.documentElement.dataset.order ?? NaN);
					let from = NaN;
					try {
						from = Number(sessionStorage.getItem('page-order') ?? NaN);
						sessionStorage.setItem('page-order', String(here));
					} catch {}
					if (!event.viewTransition?.types || Number.isNaN(here) || Number.isNaN(from)) return;
					if (here !== from) event.viewTransition.types.add(here > from ? 'forward' : 'back');
				});
			</script>
		</head>
		<body>
			<slot />
			<ScrollNav previous={previous} next={next} />
		</body>
</html>
